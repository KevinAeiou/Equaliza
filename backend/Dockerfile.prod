FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_ENV=production
ENV DJANGO_SETTINGS_MODULE=config.settings.production

WORKDIR /home/user/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

COPY requirements/base.txt .
COPY requirements/prod.txt .

RUN pip install --no-cache-dir -r prod.txt

RUN adduser --disabled-password --gecos "" appuser

COPY --chown=appuser:appuser . .

RUN python manage.py collectstatic --noinput

USER appuser

EXPOSE 8000

CMD ["sh", "-c", "python manage.py migrate --noinput && exec gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers ${GUNICORN_WORKERS:-3} --threads ${GUNICORN_THREADS:-2} --timeout ${GUNICORN_TIMEOUT:-60} --log-level info --access-logfile - --error-logfile -"]
